FROM php:8.2-apache

# Extension yang diperlukan project Adrian Laptop.
RUN docker-php-ext-install pdo_mysql \
    && a2enmod rewrite headers

WORKDIR /var/www/html
COPY . /var/www/html

# Vercel memberikan PORT saat container dijalankan. Script ini menyesuaikan Apache.
RUN chmod +x /var/www/html/docker-entrypoint-vercel.sh

EXPOSE 80
CMD ["/var/www/html/docker-entrypoint-vercel.sh"]
