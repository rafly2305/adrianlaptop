# Salin ke .env.local (lokal) dan isi di Vercel -> Settings -> Environment Variables.
# Nilai ada di Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# RAHASIA: jangan diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
